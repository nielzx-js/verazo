
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verazo - Plataforma de Oportunidades</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            verazoBg: '#FAF6F0',
            verazoCard: '#FFFFFF',
            verazoGold: '#DBB14C',
            verazoGoldHover: '#C89F3A',
            verazoDark: '#1E232A',
            verazoGray: '#6B7280',
            verazoLightGray: '#F3EFEA',
            verazoBorder: '#E5DFD7',
            verazoAccent: '#EFE7DC'
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #FAF6F0;
      color: #1E232A;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #FAF6F0;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #D1C7BD;
      border-radius: 4px;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased bg-verazoBg text-verazoDark">

  <!-- TOP SWITCHER / TOOLBAR FOR DEMO NAVIGATION -->
  <header class="sticky top-0 z-50 bg-verazoDark text-white border-b border-gray-800 shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="bg-verazoGold text-verazoDark font-bold px-2.5 py-1 rounded-md text-sm tracking-wider">VERAZO</div>
        <span class="text-xs text-gray-400 hidden sm:inline">| Visualizador de Telas Estáticas (10 Telas)</span>
      </div>

      <!-- Screen Selector -->
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <label for="screenSelect" class="text-xs font-medium text-gray-300 shrink-0">Selecione a Tela:</label>
        <select id="screenSelect" onchange="switchScreen(this.value)" class="bg-gray-800 text-verazoGold font-semibold text-xs rounded-lg px-3 py-1.5 border border-gray-700 focus:outline-none focus:ring-2 focus:ring-verazoGold w-full sm:w-72 cursor-pointer shadow-inner">
          <optgroup label="Fluxo de Autenticação">
            <option value="screen1">1. Cadastro (Criar Conta)</option>
            <option value="screen2">2. Login (Bem-vindo)</option>
            <option value="screen3">3. Redefinição - Passo 1</option>
            <option value="screen4">4. Redefinição - Passo 2</option>
            <option value="screen5">5. Senha Redefinida (Sucesso)</option>
          </optgroup>
          <optgroup label="Plataforma & Dashboards">
            <option value="screen6">6. Oportunidades / Vagas</option>
            <option value="screen7">7. Dashboard (Plano Gratuito)</option>
            <option value="screen8">8. Dashboard (Plano Premium)</option>
            <option value="screen9">9. Indicadores Profissionais</option>
            <option value="screen10">10. Mensagens / Chat</option>
          </optgroup>
        </select>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER FOR SCREENS -->
  <main class="flex-1 flex flex-col justify-center items-center p-3 sm:p-6 md:p-8">

    <!-- ========================================================================= -->
    <!-- TELA 1: CADASTRO -->
    <!-- ========================================================================= -->
    <div id="screen1" class="screen-content w-full max-w-md mx-auto py-6">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center space-x-2 mb-2">
          <div class="w-10 h-10 bg-verazoGold rounded-xl flex items-center justify-center text-verazoDark font-bold text-xl shadow-sm">V</div>
          <span class="text-2xl font-bold tracking-tight text-verazoDark">Verazo</span>
        </div>
        <h2 class="text-2xl font-bold text-verazoDark mt-2">Crie sua conta Verazo</h2>
        <p class="text-sm text-verazoGray mt-1">Preencha seus dados para começar</p>
      </div>

      <div class="bg-verazoBg p-2">
        <form onsubmit="event.preventDefault(); switchScreen('screen2');" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Nome completo</label>
            <input type="text" placeholder="Seu nome completo" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition">
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">E-mail corporativo</label>
            <input type="email" placeholder="voce@empresa.com.br" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition">
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Senha</label>
            <div class="relative">
              <input type="password" placeholder="Crie uma senha" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition pr-10">
              <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <i data-lucide="eye-off" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Confirmar senha</label>
            <div class="relative">
              <input type="password" placeholder="Repita sua senha" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition pr-10">
              <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <i data-lucide="eye-off" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <div class="flex items-center pt-1">
            <input id="terms" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-verazoGold focus:ring-verazoGold accent-verazoGold cursor-pointer">
            <label for="terms" class="ml-2 text-xs text-verazoDark cursor-pointer">Concordo com os <a href="#" class="font-semibold underline">termos de uso</a></label>
          </div>

          <button type="submit" class="w-full py-3.5 px-4 bg-verazoGold hover:bg-verazoGoldHover text-verazoDark font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm transition mt-4">
            CRIAR CONTA VERAZO
          </button>
        </form>

        <div class="mt-6 text-center">
          <p class="text-xs text-verazoGray">
            Já tem conta? <button onclick="switchScreen('screen2')" class="font-semibold text-verazoDark hover:underline">Faça login</button>
          </p>
        </div>
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- TELA 2: LOGIN -->
    <!-- ========================================================================= -->
    <div id="screen2" class="screen-content w-full max-w-md mx-auto py-6 hidden">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center space-x-2 mb-2">
          <div class="w-10 h-10 bg-verazoGold rounded-xl flex items-center justify-center text-verazoDark font-bold text-xl shadow-sm">V</div>
          <span class="text-2xl font-bold tracking-tight text-verazoDark">Verazo</span>
        </div>
        <h2 class="text-2xl font-bold text-verazoDark mt-2">Bem-vindo de volta</h2>
        <p class="text-xs text-verazoGray mt-1">Entre na sua conta e acompanhe suas oportunidades no Verazo.</p>
      </div>

      <div class="bg-verazoBg p-2">
        <form onsubmit="event.preventDefault(); switchScreen('screen6');" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">E-mail corporativo</label>
            <input type="email" value="voce@empresa.com.br" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition">
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Senha</label>
            <div class="relative">
              <input type="password" placeholder="Digite sua senha" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition pr-10">
              <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <i data-lucide="eye-off" class="w-5 h-5"></i>
              </button>
            </div>
            <div class="text-right mt-1.5">
              <button type="button" onclick="switchScreen('screen3')" class="text-xs text-verazoGray hover:text-verazoDark">
                Esqueceu sua senha? <span class="font-bold text-verazoDark">Redefinir</span>
              </button>
            </div>
          </div>

          <button type="submit" class="w-full py-3.5 px-4 bg-verazoGold hover:bg-verazoGoldHover text-verazoDark font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm transition mt-2">
            ENTRAR NO VERAZO
          </button>
        </form>

        <div class="mt-6 text-center">
          <p class="text-xs text-verazoGray">
            Ainda não tem conta? <button onclick="switchScreen('screen1')" class="font-semibold text-verazoDark hover:underline">Cadastre-se</button>
          </p>
        </div>
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- TELA 3: REDEFINIÇÃO DE SENHA - PASSO 1 -->
    <!-- ========================================================================= -->
    <div id="screen3" class="screen-content w-full max-w-md mx-auto py-6 hidden">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center space-x-2 mb-2">
          <div class="w-10 h-10 bg-verazoGold rounded-xl flex items-center justify-center text-verazoDark font-bold text-xl shadow-sm">V</div>
          <span class="text-2xl font-bold tracking-tight text-verazoDark">Verazo</span>
        </div>
        <h2 class="text-2xl font-bold text-verazoDark mt-2">Redefinição de senha</h2>
        <p class="text-xs text-verazoGray mt-1 px-4">Informe seu e-mail corporativo e o código de redefinição recebido para continuar.</p>
      </div>

      <div class="bg-verazoBg p-2">
        <form onsubmit="event.preventDefault(); switchScreen('screen4');" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">E-mail corporativo</label>
            <input type="email" value="voce@empresa.com.br" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition">
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Código de redefinição de senha</label>
            <input type="text" placeholder="Digite o código recebido" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition">
          </div>

          <button type="submit" class="w-full py-3.5 px-4 bg-verazoGold hover:bg-verazoGoldHover text-verazoDark font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm transition mt-4">
            PRÓXIMO
          </button>
        </form>
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- TELA 4: REDEFINIÇÃO DE SENHA - PASSO 2 (NOVA SENHA) -->
    <!-- ========================================================================= -->
    <div id="screen4" class="screen-content w-full max-w-md mx-auto py-6 hidden">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center space-x-2 mb-2">
          <div class="w-10 h-10 bg-verazoGold rounded-xl flex items-center justify-center text-verazoDark font-bold text-xl shadow-sm">V</div>
          <span class="text-2xl font-bold tracking-tight text-verazoDark">Verazo</span>
        </div>
        <h2 class="text-2xl font-bold text-verazoDark mt-2">Redefinição de senha</h2>
        <p class="text-xs text-verazoGray mt-1 px-4">Escolha uma nova senha para acessar sua conta com segurança.</p>
      </div>

      <div class="bg-verazoBg p-2">
        <form onsubmit="event.preventDefault(); switchScreen('screen5');" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Nova senha</label>
            <div class="relative">
              <input type="password" placeholder="Digite sua nova senha" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition pr-10">
              <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <i data-lucide="eye-off" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-verazoDark mb-1">Confirmar nova senha</label>
            <div class="relative">
              <input type="password" placeholder="Repita sua nova senha" class="w-full px-4 py-3 rounded-lg border border-verazoBorder bg-white text-sm focus:outline-none focus:ring-2 focus:ring-verazoGold transition pr-10">
              <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <i data-lucide="eye-off" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <p class="text-[11px] text-verazoGray">Use pelo menos 8 caracteres, incluindo letras e números.</p>

          <button type="submit" class="w-full py-3.5 px-4 bg-verazoGold hover:bg-verazoGoldHover text-verazoDark font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm transition mt-2">
            PRÓXIMO
          </button>
        </form>
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- TELA 5: SUCESSO NA REDEFINIÇÃO -->
    <!-- ========================================================================= -->
    <div id="screen5" class="screen-content w-full max-w-md mx-auto py-12 hidden">
      <div class="text-center space-y-6">
        <div class="inline-flex items-center justify-center space-x-2">
          <div class="w-12 h-12 bg-verazoGold rounded-xl flex items-center justify-center text-verazoDark font-bold text-2xl shadow-sm">V</div>
          <span class="text-3xl font-bold tracking-tight text-verazoDark">Verazo</span>
        </div>

        <div class="py-6 flex flex-col items-center">
          <div class="w-16 h-16 bg-[#EFE7DC] rounded-full flex items-center justify-center mb-6">
            <i data-lucide="check" class="w-8 h-8 text-verazoDark stroke-[3]"></i>
          </div>

          <h2 class="text-2xl font-bold text-verazoDark leading-snug">Senha redefinida com<br>sucesso!</h2>
          <p class="text-xs text-verazoGray mt-4">Redirecionando para Verazo...</p>
        </div>

        <div class="pt-4">
          <button onclick="switchScreen('screen2')" class="text-xs font-semibold text-verazoDark underline">Ir para o login agora</button>
        </div>
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- LAYOUT DE DASHBOARD COMPARTILHADO PARA TELAS 6, 7, 8, 9, 10 -->
    <!-- ========================================================================= -->
    <div id="appShell" class="screen-content w-full max-w-7xl mx-auto bg-verazoBg rounded-2xl shadow-lg border border-verazoBorder overflow-hidden hidden flex flex-col md:flex-row min-h-[780px]">
      
      <!-- SIDEBAR COMPONENTE -->
      <aside class="w-full md:w-64 bg-verazoBg border-r border-verazoBorder flex flex-col justify-between shrink-0">
        <div>
          <!-- Logo -->
          <div class="p-5 border-b border-verazoBorder/60 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <div class="w-7 h-7 bg-verazoGold rounded-lg flex items-center justify-center text-verazoDark font-bold text-base shadow-sm">V</div>
              <span class="text-lg font-bold text-verazoDark tracking-tight">Verazo</span>
            </div>
            <span class="text-[10px] font-semibold bg-verazoAccent px-2 py-0.5 rounded text-verazoDark">v2.4</span>
          </div>

          <!-- Navigation Links -->
          <nav class="p-3 space-y-1">
            <button onclick="switchScreen('screen7')" id="nav-screen7" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-verazoDark hover:bg-verazoAccent/70 transition">
              <i data-lucide="layout-dashboard" class="w-4 h-4 text-verazoGray"></i>
              <span>Dashboard</span>
            </button>
            <button onclick="switchScreen('screen6')" id="nav-screen6" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-verazoDark hover:bg-verazoAccent/70 transition">
              <i data-lucide="briefcase" class="w-4 h-4 text-verazoGray"></i>
              <span>Oportunidades</span>
            </button>
            <button onclick="switchScreen('screen10')" id="nav-screen10" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-verazoDark hover:bg-verazoAccent/70 transition">
              <i data-lucide="message-square" class="w-4 h-4 text-verazoGray"></i>
              <span>Mensagens</span>
              <span class="ml-auto bg-verazoGold text-verazoDark font-bold text-[10px] px-1.5 py-0.2 rounded-full">3</span>
            </button>
            <button onclick="switchScreen('screen9')" id="nav-screen9" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-verazoDark hover:bg-verazoAccent/70 transition">
              <i data-lucide="user" class="w-4 h-4 text-verazoGray"></i>
              <span>Meu perfil</span>
            </button>
            <button onclick="switchScreen('screen8')" id="nav-screen8" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-xs font-medium text-verazoDark hover:bg-verazoAccent/70 transition">
              <i data-lucide="credit-card" class="w-4 h-4 text-verazoGray"></i>
              <span>Planos</span>
            </button>
          </nav>
        </div>

        <!-- User Profile Footer in Sidebar -->
        <div class="p-4 border-t border-verazoBorder/60 bg-verazoBg/50">
          <div class="flex items-center space-x-3 mb-3">
            <div class="w-9 h-9 bg-verazoAccent border border-verazoBorder rounded-full flex items-center justify-center font-bold text-xs text-verazoDark">
              AL
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-verazoDark truncate">Alex Lima</p>
              <p class="text-[11px] text-verazoGray truncate">Desenvolvedor</p>
              <span id="userBadge" class="inline-block text-[10px] font-semibold text-verazoGray mt-0.5">Plano gratuito</span>
            </div>
          </div>
          <div class="space-y-1 text-xs">
            <button onclick="switchScreen('screen2')" class="w-full text-left py-1 text-verazoGray hover:text-verazoDark flex items-center space-x-1.5">
              <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
              <span>Sair</span>
            </button>
            <button class="w-full text-left py-1 text-red-500/80 hover:text-red-600 text-[11px]">
              Excluir conta
            </button>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT AREA FOR DASHBOARDS -->
      <div class="flex-1 flex flex-col overflow-hidden bg-verazoBg">
        
        <!-- Top Search & Header Bar -->
        <header class="h-16 border-b border-verazoBorder/60 px-6 flex items-center justify-between shrink-0 bg-verazoBg">
          <div class="flex items-center space-x-2 text-xs text-verazoGray">
            <span>Olá, <strong class="text-verazoDark">Alex</strong></span>
          </div>

          <!-- Search Input -->
          <div class="relative w-full max-w-xs md:max-w-md">
            <i data-lucide="search" class="w-4 h-4 text-verazoGray absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" placeholder="Procurar vagas, talentos, etc..." class="w-full pl-9 pr-4 py-2 rounded-lg border border-verazoBorder bg-white text-xs focus:outline-none focus:ring-1 focus:ring-verazoGold">
          </div>
        </header>

        <!-- SUB-SCREENS INSIDE DASHBOARD SHELL -->
        <div class="flex-1 overflow-y-auto custom-scrollbar p-6">

          <!-- ========================================================================= -->
          <!-- TELA 6: OPORTUNIDADES / VAGAS -->
          <!-- ========================================================================= -->
          <div id="subscreen6" class="subscreen space-y-6 hidden">
            <div>
              <h1 class="text-xl font-bold text-verazoDark">Recomendações</h1>
              <p class="text-xs text-verazoGray">Oportunidades para o próximo passo da sua carreira.</p>
            </div>

            <div class="bg-verazoAccent/30 rounded-xl p-4 border border-verazoBorder/40">
              <div class="flex items-center justify-between mb-1">
                <h3 class="text-xs font-bold text-verazoDark uppercase tracking-wide">Vagas premium recomendadas para você</h3>
                <span class="text-[10px] bg-verazoGold/20 text-verazoDark px-2 py-0.5 rounded font-medium">Dados demonstrativos</span>
              </div>
              <p class="text-xs text-verazoGray">Uma seleção de oportunidades alinhadas às suas habilidades.</p>
            </div>

            <!-- GRID DE VAGAS -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              
              <!-- Card 1: Nimbo Labs -->
              <div class="bg-white p-4 rounded-xl border border-verazoBorder shadow-sm flex flex-col justify-between">
                <div>
                  <div class="flex items-start space-x-3 mb-3">
                    <div class="w-9 h-9 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-lg flex items-center justify-center shrink-0">NL</div>
                    <div>
                      <h4 class="text-xs font-bold text-verazoDark">Nimbo Labs</h4>
                      <p class="text-[10px] text-verazoGray">Empresa fictícia</p>
                    </div>
                  </div>
                  <h3 class="font-bold text-sm text-verazoDark mb-1">Desenvolvedor Front-end</h3>
                  <p class="text-[11px] text-verazoGray mb-3">Remoto · CLT · Júnior</p>
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    <span class="bg-verazoLightGray text-verazoDark text-[10px] px-2 py-0.5 rounded font-medium">React</span>
                    <span class="bg-verazoLightGray text-verazoDark text-[10px] px-2 py-0.5 rounded font-medium">TypeScript</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                  <span class="text-xs font-bold text-verazoDark">R$ 4.000 - 5.500</span>
                  <button class="px-3 py-1.5 bg-verazoGold hover:bg-verazoGoldHover text-verazoDark font-bold text-[11px] rounded-lg transition">Ver vaga</button>
                </div>
              </div>

              <!-- Card 2: Órbita Sistemas -->
              <div class="bg-white p-4 rounded-xl border border-verazoBorder shadow-sm flex flex-col justify-between">
