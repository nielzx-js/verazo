  <!-- JAVASCRIPT SWITCHING LOGIC -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Screen Switching Logic
    function switchScreen(screenId) {
      // Update dropdown selector value
      document.getElementById('screenSelect').value = screenId;

      // Hide all root screens
      const screens = document.querySelectorAll('.screen-content');
      screens.forEach(s => s.classList.add('hidden'));

      // Dashboard App Shell Container
      const appShell = document.getElementById('appShell');

      // Dashboard Subscreens IDs
      const subScreenMap = {
        'screen6': 'subscreen6',
        'screen7': 'subscreen7',
        'screen8': 'subscreen8',
        'screen9': 'subscreen9',
        'screen10': 'subscreen10'
      };

      if (subScreenMap[screenId]) {
        // Show Shell
        appShell.classList.remove('hidden');

        // Hide all subscreens
        const subscreens = document.querySelectorAll('.subscreen');
        subscreens.forEach(sub => sub.classList.add('hidden'));

        // Show selected subscreen
        const targetSubscreen = document.getElementById(subScreenMap[screenId]);
        if (targetSubscreen) {
          targetSubscreen.classList.remove('hidden');
        }

        // Update active class on navigation sidebar
        document.querySelectorAll('.nav-btn').forEach(btn => {
          btn.classList.remove('bg-verazoGold', 'font-bold');
          btn.classList.add('text-verazoDark');
        });

        const activeNavBtn = document.getElementById('nav-' + screenId);
        if (activeNavBtn) {
          activeNavBtn.classList.add('bg-verazoGold', 'font-bold');
        }

        // Update user badge depending on screen 8 (Premium Demo) or 7 (Free Demo)
        const userBadge = document.getElementById('userBadge');
        if (userBadge) {
          if (screenId === 'screen8' || screenId === 'screen9' || screenId === 'screen10') {
            userBadge.innerText = 'Premium ativo';
            userBadge.className = 'inline-block text-[10px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.2 rounded mt-0.5';
          } else {
            userBadge.innerText = 'Plano gratuito';
            userBadge.className = 'inline-block text-[10px] font-semibold text-verazoGray mt-0.5';
          }
        }

      } else {
        // Auth screens (1 to 5)
        const targetScreen = document.getElementById(screenId);
        if (targetScreen) {
          targetScreen.classList.remove('hidden');
        }
      }

      // Re-render icons if needed
      lucide.createIcons();
    }

    // Default screen load
    window.addEventListener('DOMContentLoaded', () => {
      switchScreen('screen1');
    });
  </script>
